{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "ModelContextProtocol": "Warning"
      }
    }
  },
  "EngineeringMcp": {
    "Database": {
      "Provider": "Sqlite",
      "ConnectionString": "Data Source=samples/data/demo.db",
      "SeedScript": "samples/data/seed.sql",
      "MaxRows": 200,
      "CommandTimeoutSeconds": 10
    },
    "Docs": {
      "Root": "samples/docs",
      "MaxSearchResults": 20
    },
    "Git": {
      "RepositoryPath": ".",
      "MaxCommits": 50
    },
    "HealthChecks": {
      "TimeoutSeconds": 5,
      "Endpoints": []
    }
  }
}
